{
  "manifest_version": 3,
  "name": "Lazarus Revived — Form Recovery",
  "version": "1.0.0",
  "description": "Saves what you type into forms as you type it, so a crash, timeout or botched submit never loses your text again. Right-click any field to recover.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Lazarus Revived",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["lib/heuristics.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
